# Copy to .env.local and fill in. See .env.local comments for which values
# are server-only. Set the same variables on Vercel (Project → Settings →
# Environment Variables) for Production and Preview deploys.
#
# Placeholders only — real values live in the git-ignored .env.local.

GEMINI_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
FIRECRAWL_API_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Auth email. Sign-in is a link in an inbox, so these are what stands between
# a user and their account. The app itself never reads them — they are applied
# to the Supabase project by `pnpm auth:configure`, which stores the Resend key
# as the SMTP password. See docs/auth.md.
RESEND_API_KEY=
AUTH_EMAIL_FROM=no-reply@1resume.app
AUTH_EMAIL_FROM_NAME=1Resume
SITE_URL=https://www.1resume.app

# Account-wide Supabase personal access token, for `pnpm auth:configure` only.
# Never set this on Vercel.
SUPABASE_ACCESS_TOKEN=

# Google Ads conversion tracking. Leave the id blank anywhere you don't want
# conversions reported — dev and preview deploys included — and the tag isn't
# rendered at all. The labels come from Google Ads → Goals → Conversions, one
# per conversion action; without them the matching call is a no-op.
# Format: NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX, labels are the part after the
# slash in the snippet Google shows you.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_LABEL=
